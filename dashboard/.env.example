# Neon's *pooled* connection string (host contains "-pooler"), used by the app at runtime.
# Vercel's Neon integration adds it to the Vercel project; locally put it here.
# Migrations derive the direct host from it (prisma.config.ts); DATABASE_URL_UNPOOLED, if set
# (Vercel adds it too), is used instead.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# HMAC secret of device hub-01. `npm run db:seed` stores it in the database (that copy is what
# /api/ingest checks, so Vercel does not need this variable); the sender (scripts/send-sample.mjs,
# later the hub) signs with it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_SECRET=""

# Only for `npm run db:migrate:dev` (creating new migrations): the throwaway Postgres that
# `npm run db:shadow` starts in Docker.
# SHADOW_DATABASE_URL="postgresql://postgres:shadow@localhost:55432/postgres"
