# Neon: use the *pooled* string for DATABASE_URL and the direct (non-pooler) one for DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/cocis?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/cocis?sslmode=require"

# Dev-only HMAC secret for hub-01 (used by prisma/seed.ts and scripts/send-sample.mjs).
# Use a long random value in production and flash the same value into the firmware.
DEVICE_SECRET="dev-secret-hub-01-change-me"
