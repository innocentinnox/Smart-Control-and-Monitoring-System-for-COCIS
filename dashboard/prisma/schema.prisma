// Cloud side of docs/event-schema.md.
// `Event` is the raw, append-only log (exactly what the hub sent); the typed tables are
// projections of it so pages can query without digging through JSON. Every table that
// comes from an event carries (deviceId, seq) as a unique key, which is what makes
// re-sending a batch harmless.

// Prisma 7: the TypeScript client is generated into lib/generated/prisma (git-ignored) and
// connects through a driver adapter (lib/db.ts). Connection strings live in prisma.config.ts.
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Device {
  id         String    @id // e.g. "hub-01", sent as X-Device-Id
  name       String
  secret     String // HMAC-SHA256 key shared with the firmware
  lastSeenAt DateTime?
  lastSeq    Int? // highest seq acknowledged so far
  createdAt  DateTime  @default(now())

  events    Event[]
  access    AccessEvent[]
  rooms     RoomEvent[]
  lights    LightEvent[]
  energy    EnergySample[]
  alerts    Alert[]
}

/// Raw event log, one row per hub event.
model Event {
  id         Int      @id @default(autoincrement())
  deviceId   String
  seq        Int
  ts         DateTime // hub local time (EAT) converted to UTC
  type       String
  data       Json
  hash       String? // SD-card hash chain value, kept for audit
  receivedAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id])

  @@unique([deviceId, seq])
  @@index([type, ts])
}

model AccessEvent {
  id       Int      @id @default(autoincrement())
  deviceId String
  seq      Int
  ts       DateTime
  uid      String
  name     String
  role     String
  side     String // IN | OUT
  ok       Boolean
  reason   String

  device Device @relation(fields: [deviceId], references: [id])

  @@unique([deviceId, seq])
  @@index([uid, ts])
  @@index([ts])
}

/// Room state changes: occupied <-> vacant, or daylight crossing a threshold.
model RoomEvent {
  id       Int      @id @default(autoincrement())
  deviceId String
  seq      Int
  ts       DateTime
  room     Int
  occupied Boolean
  daylight Boolean? // enough daylight for the lamp to stay off
  lux      Int? // measured light level

  device Device @relation(fields: [deviceId], references: [id])

  @@unique([deviceId, seq])
  @@index([room, ts])
}

model LightEvent {
  id       Int      @id @default(autoincrement())
  deviceId String
  seq      Int
  ts       DateTime
  room     Int
  level    Int // 0-100 %
  mode     String // AUTO | ON | OFF
  lux      Int? // light level when the lamp changed

  device Device @relation(fields: [deviceId], references: [id])

  @@unique([deviceId, seq])
  @@index([room, ts])
}

/// Running energy totals per room since hub boot (sent every 10 min).
model EnergySample {
  id       Int      @id @default(autoincrement())
  deviceId String
  seq      Int
  ts       DateTime
  room     Int
  onWh     Float
  savedWh  Float

  device Device @relation(fields: [deviceId], references: [id])

  @@unique([deviceId, seq])
  @@index([room, ts])
}

model Alert {
  id           Int      @id @default(autoincrement())
  deviceId     String
  seq          Int
  ts           DateTime
  code         String
  detail       String
  acknowledged Boolean  @default(false)

  device Device @relation(fields: [deviceId], references: [id])

  @@unique([deviceId, seq])
  @@index([ts])
}
